# ============================================================================
# Vibe-Trading SaaS — Environment Configuration
# Copy to .env and fill in your values
# ============================================================================

# --- Role ---
ROLE=central  # central | worker | engine | bot

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
API_KEY=vt-CHANGE_ME_TO_RANDOM_48_CHARS

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vibetrader
POSTGRES_USER=vt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Vibe-Trading Engine ---
VIBE_ENGINE_URL=http://engine:8899
VIBE_ENGINE_API_KEY=vt-CHANGE_ME_TO_RANDOM_48_CHARS

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ALLOWED_USERS=  # comma-separated Telegram user IDs (empty = allow all)

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS=100
WORKER_NAME=worker-1

# --- Rate Limits ---
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_SESSIONS_PER_DAY=50
MESSAGE_MIN_INTERVAL_SECONDS=2.0

# --- Anti-Abuse ---
MAX_ACCOUNTS_PER_DEVICE=1

# --- Payment (IDPay) ---
IDPAY_API_KEY=
IDPAY_MERCHANT_ID=
