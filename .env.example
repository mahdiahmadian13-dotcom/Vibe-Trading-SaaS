# ============================================================================
# Vibe-Trading SaaS — Environment Configuration
# Copy to .env and fill in your values
# ============================================================================

# --- Role ---
ROLE=central  # central | worker | engine | bot

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
API_KEY=vt-CHANGE_ME_TO_RANDOM_48_CHARS

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vibetrader
POSTGRES_USER=vt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Vibe-Trading Engine ---
VIBE_ENGINE_URL=http://engine:8899
VIBE_ENGINE_API_KEY=vt-CHANGE_ME_TO_RANDOM_48_CHARS

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ALLOWED_USERS=  # comma-separated Telegram user IDs (empty = allow all)
FLEET_ALERT_TG_IDS=  # US13 T040: admin Telegram IDs for server down/up alerts (comma-separated)

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_MAX_TASKS=100
WORKER_NAME=worker-1

# --- Rate Limits ---
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_SESSIONS_PER_DAY=50
MESSAGE_MIN_INTERVAL_SECONDS=2.0

# --- Anti-Abuse ---
MAX_ACCOUNTS_PER_DEVICE=1

# --- Payment (IDPay) ---
IDPAY_API_KEY=
IDPAY_MERCHANT_ID=
# Public URL of this gateway (for payment callbacks), e.g. http://SERVER_IP:9001
PUBLIC_BASE_URL=
PAYMENT_CALLBACK_URL=

# --- Fleet (multi-server) ---
FLEET_HEALTH_INTERVAL=30
FLEET_HEALTH_FAILS=2
# Master key for encrypted SSH credentials (server_nodes.ssh_secret).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLEET_MASTER_KEY=
# --- Private networking (US8/US13, FR-016) ---
# Remote nodes MUST reach the center ONLY over a private network
# (Tailscale or VPN). Never expose 6379/5432/8899 on the public internet.
# Setup: install Tailscale on center + nodes (same tailnet), then set the
# *_PUBLIC URLs below to the center's TAILSCALE IP (100.x.y.z):
#   REDIS_URL_PUBLIC=redis://100.x.y.z:6379/0
#   DATABASE_URL_PUBLIC=postgresql+asyncpg://vt:PASS@100.x.y.z:5432/vibetrader
#   VIBE_ENGINE_URL_PUBLIC=http://100.x.y.z:8899
# Keep PUBLISH_REDIS/PUBLISH_PG on 127.0.0.1 (docker bridge only) — the
# Tailscale interface is NOT docker; bind via Tailscale serve or firewall
# the public NIC to drop 6379/5432/8899 from the internet.
